# Firebase web app config (Firebase console > Project settings > Your apps > Web app).
# These values are not secrets; access is controlled by firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional TURN server. Needed when two people are on networks that block direct
# peer-to-peer connections (many mobile carriers and office networks).
# VITE_TURN_URL can hold several URLs separated by commas.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
