rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    match /rooms/{roomId} {
      // Rooms can be fetched by ID but never listed, so IDs stay private.
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.keys().hasOnly(['offer', 'hostId', 'createdAt']);

      // One guest may attach an answer, and only while no answer exists yet.
      allow update: if signedIn()
        && !('answer' in resource.data)
        && request.resource.data.guestId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer', 'guestId']);

      allow delete: if signedIn() && resource.data.hostId == request.auth.uid;

      match /callerCandidates/{id} {
        allow read, create, delete: if signedIn();
      }
      match /calleeCandidates/{id} {
        allow read, create, delete: if signedIn();
      }
    }
  }
}
